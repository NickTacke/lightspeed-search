DATABASE_URL=postgres://postgres:postgres@localhost:5433/aidey
API_PORT=3001
WEB_PORT=5173
WEB_URL=http://localhost:5173
API_URL=http://localhost:3001

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-hex-string
BETTER_AUTH_URL=http://localhost:3001

# Resend
RESEND_API_KEY=
EMAIL_FROM=Aidey <noreply@aidey.app>
EMAIL_DEV_MODE=true

# OpenAI
OPENAI_API_KEY=

# Lightspeed
LIGHTSPEED_APP_KEY=
LIGHTSPEED_APP_SECRET=
# OAUTH_STATE_SECRET signs the CSRF state JWT carried through the LS OAuth handshake.
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# M11 — observability + deploy
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN_API=
VITE_SENTRY_DSN_WEB=
VITE_GIT_SHA=dev
