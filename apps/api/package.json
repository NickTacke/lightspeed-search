{
  "name": "@aidey/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "find src tests -name '*.test.*' 2>/dev/null | grep -q . && bun test || echo 'no tests yet'"
  },
  "dependencies": {
    "@aidey/alerts": "workspace:*",
    "@aidey/catalog": "workspace:*",
    "@aidey/contracts": "workspace:*",
    "@aidey/database": "workspace:*",
    "@aidey/identity": "workspace:*",
    "@aidey/lightspeed": "workspace:*",
    "@aidey/search": "workspace:*",
    "@aidey/shops": "workspace:*",
    "@aidey/sync": "workspace:*",
    "@hono/zod-openapi": "^1.3.0",
    "@sentry/bun": "^10.54.0",
    "hono": "^4.12.16",
    "pino": "^10.3.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@aidey/tsconfig": "workspace:*",
    "pino-pretty": "^13.1.3"
  }
}
