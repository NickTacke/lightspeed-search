{
  "name": "@aidey/widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.alerts.ts",
    "build": "bun run build:loader && bun run build:alerts && bun run build:search",
    "build:loader": "vite build --config vite.config.loader.ts",
    "build:alerts": "vite build --config vite.config.alerts.ts",
    "build:search": "vite build --config vite.config.search.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "find src tests -name '*.test.*' 2>/dev/null | grep -q . && bun test || echo 'no tests yet'"
  },
  "dependencies": {
    "@aidey/api-client": "workspace:*",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@aidey/tsconfig": "workspace:*",
    "@happy-dom/global-registrator": "^20.9.0",
    "@preact/preset-vite": "^2.10.0",
    "happy-dom": "^20.9.0",
    "vite": "^8.0.10"
  }
}
