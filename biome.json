{
  "$schema": "https://biomejs.dev/schemas/2.3.0/schema.json",
  "files": {
    "ignore": ["**/dist", "**/generated", "**/node_modules", "**/*.css", "**/route-tree.gen.ts", "**/routeTree.gen.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": { "recommended": true }
  },
  "organizeImports": { "enabled": true }
}
