{
  "name": "@aidey/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tanstack": "./src/generated/@tanstack/react-query.gen.ts"
  },
  "scripts": {
    "generate": "openapi-ts",
    "dev": "openapi-ts --watch 5000",
    "typecheck": "tsc --noEmit",
    "test": "find src tests -name '*.test.*' 2>/dev/null | grep -q . && bun test || echo 'no tests yet'"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@tanstack/react-query": "^5.100.7"
  },
  "devDependencies": {
    "@aidey/tsconfig": "workspace:*",
    "@hey-api/openapi-ts": "^0.97.0"
  }
}
